# Copy to scripts/config.env and adjust. That file is git-ignored, so values
# specific to your environment never reach this public repository.
#
#   cp scripts/config.env.example scripts/config.env

# Required. The resource group is resolved automatically from this name.
CLUSTER_NAME=aks-lab

# Optional, skips the lookup above.
#RESOURCE_GROUP=mpetitRG

# Required by 01-whitelist-ip.sh. CIDR notation, comma separated for several.
# A single address is a /32.
ALLOWED_CIDR=203.0.113.10/32

# Entra ID groups driving cluster access.
ADMIN_GROUP=aks-lab-admin
READER_GROUP=aks-lab-reader

# Namespace holding the resource limitation policy.
PROD_NAMESPACE=prod

# Workload identity.
IDENTITY_NAME=id-prod-app
SERVICE_ACCOUNT=prod-app
